<Window x:Class="WpfStlViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="Milestone 2: The STL Inspector" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#f0f0f0" Margin="10">
            <Button Content="Load .STL File" Click="LoadFile_Click" Margin="0,0,0,20" Padding="10"/>

            <TextBlock Text="Mesh Statistics" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock x:Name="TxtVertices" Text="Vertices: 0" Margin="0,5"/>
            <TextBlock x:Name="TxtTriangles" Text="Triangles: 0" Margin="0,5"/>

            <TextBlock Text="Bounding Box" FontWeight="Bold" FontSize="16" Margin="0,20,0,10"/>
            <TextBlock x:Name="TxtSizeX" Text="Size X: 0 mm" Margin="0,5"/>
            <TextBlock x:Name="TxtSizeY" Text="Size Y: 0 mm" Margin="0,5"/>
            <TextBlock x:Name="TxtSizeZ" Text="Size Z: 0 mm" Margin="0,5"/>

            <TextBlock Text="Mathematical Center" FontWeight="Bold" FontSize="16" Margin="0,20,0,10"/>
            <TextBlock x:Name="TxtCenterX" Text="Center X: 0" Margin="0,5"/>
            <TextBlock x:Name="TxtCenterY" Text="Center Y: 0" Margin="0,5"/>
            <TextBlock x:Name="TxtCenterZ" Text="Center Z: 0" Margin="0,5"/>
        </StackPanel>

        <helix:HelixViewport3D Grid.Column="1" x:Name="Viewport3D" 
                               ShowCoordinateSystem="True" 
                               Background="#333333">
            <helix:DefaultLights/>
            <ModelVisual3D x:Name="ModelContainer"/>
        </helix:HelixViewport3D>
    </Grid>
</Window>