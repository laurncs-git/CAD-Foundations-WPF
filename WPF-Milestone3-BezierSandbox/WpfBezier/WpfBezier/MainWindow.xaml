<Window x:Class="WpfBezier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Milestone 3: The Bezier Sandbox" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Background="#f0f0f0" Orientation="Horizontal">
            <TextBlock Text="Drag the 4 red points to bend the math!" 
                       VerticalAlignment="Center" Margin="15" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <Canvas x:Name="DrawingCanvas" Grid.Row="1" Background="White"
                MouseMove="Canvas_MouseMove" 
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp">

            <Polyline x:Name="ControlPolygon" Stroke="LightGray" StrokeThickness="2" StrokeDashArray="4 4"/>

            <Polyline x:Name="BezierCurve" Stroke="Blue" StrokeThickness="4"/>

            <Ellipse x:Name="Point0" Width="16" Height="16" Fill="Red" MouseLeftButtonDown="Point_MouseDown" Cursor="Hand"/>
            <Ellipse x:Name="Point1" Width="16" Height="16" Fill="DarkRed" MouseLeftButtonDown="Point_MouseDown" Cursor="Hand"/>
            <Ellipse x:Name="Point2" Width="16" Height="16" Fill="DarkRed" MouseLeftButtonDown="Point_MouseDown" Cursor="Hand"/>
            <Ellipse x:Name="Point3" Width="16" Height="16" Fill="Red" MouseLeftButtonDown="Point_MouseDown" Cursor="Hand"/>
        </Canvas>
    </Grid>
</Window>